-- Generic mailbox harness: drains the stdout ring at $7FE010 into @LOGFILE@
-- every frame and exits with the ROM's status word once it goes nonzero.
-- Exit codes: status word (1 = pass, 0xDEAD = panic, ...), or
--   99 = still running after @MAXFRAMES@ frames
--   98 = magic never appeared (ROM did not boot)
--   97 = ring overflow (ROM wrote >8176 bytes between two frames)

-- mailbox lives at $7FE000; snesWorkRam offsets are relative to $7E0000
local MB_MAGIC, MB_STATUS, MB_WINDEX, MB_RING = 0x1E000, 0x1E002, 0x1E004, 0x1E010
local RING_SIZE = 8176

local frames = 0
local sawMagic = false
local readIndex = 0
local logf = io.open("@LOGFILE@", "wb")

local function word(addr)
  return emu.readWord(addr, emu.memType.snesWorkRam, false)
end

local function drain()
  local wi = word(MB_WINDEX)
  local pending = (wi - readIndex) % 65536
  if pending > RING_SIZE then
    logf:close()
    emu.stop(97)
    return
  end
  while readIndex ~= wi do
    local b = emu.read(MB_RING + (readIndex % RING_SIZE), emu.memType.snesWorkRam)
    logf:write(string.char(b))
    readIndex = (readIndex + 1) % 65536
  end
  logf:flush()
end

local function onFrame()
  frames = frames + 1
  if not sawMagic then
    if word(MB_MAGIC) == 0xCAFE then
      sawMagic = true
    elseif frames > 600 then
      logf:close()
      emu.stop(98)
      return
    else
      return
    end
  end

  drain()
  local status = word(MB_STATUS)
  if status ~= 0 then
    drain()
    logf:close()
    emu.stop(status)
    return
  end
  if frames >= @MAXFRAMES@ then
    logf:close()
    emu.stop(99)
  end
end

emu.addEventCallback(onFrame, emu.eventType.endFrame)
