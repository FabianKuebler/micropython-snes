# Standalone vbcc 65816 build of the MicroPython SNES port, parallel to the
# Calypsi path in ./Makefile. Exists to answer one question: does vbcc's
# callee-saved register model dodge the re-entrant-VM miscompile that blocks
# M4 on Calypsi (see DECISIONS.md)?
#
#   make -f Makefile.vbcc mpy-vbcc     # build build/vbcc/mpy.sfc
#   tools/vbcc_run.sh build/vbcc/mpy.sfc
#
# Generated headers (genhdr/*) and frozen_content.c are compiler-agnostic and
# are produced by the main Makefile; we reuse them.

VBCC := $(CURDIR)/vbcc-toolchain/vbcc65816/vbcc65816_linux/vbcc
export VBCC               # vc locates config files via the VBCC env var
export PATH := $(VBCC)/bin:$(PATH)   # vc invokes vbcc65816/vasm/vlink by name
VC   := $(VBCC)/bin/vc
AS   := $(VBCC)/bin/vasm6502_oldstyle
ASFLAGS := -816 -vobj3 -quiet -nowarn=62 -opt-branch -ldots -Fvobj
VLINK := $(VBCC)/bin/vlink
TGT  := $(VBCC)/targets/65816-snes

MPTOP := micropython
PORT := port
PYTHON := python3
BUILD := build
MPBUILD := $(BUILD)/mpy
VBUILD := $(BUILD)/vbcc
GENHDR := $(MPBUILD)/genhdr

# Far/huge memory model (+snes-hi), -O1 to mirror the Calypsi correctness flag.
# unistd shim supplies ssize_t; include paths match the Calypsi MP_INC plus the
# repo root for snes/mailbox.h.
VCFLAGS := +snes-hi -c99 -O1 -DNDEBUG -Ivbcc_spike/shim -I. -Imicropython -Iport -Ibuild/mpy -Isnes

# Bytecode-VM subset. The native-code emitters and per-arch assemblers
# (asm*/emitn*/emitinline*/emitndebug) are NOT linked: MICROPY_EMIT_NATIVE is
# off, and on vbcc they leave unresolved cross-references (e.g. asm_xtensa_op24,
# scope_find_or_add_id) that the bytecode VM never needs. The bytecode emitter
# (emitbc/emitcommon) and glue (emitglue) ARE kept.
PY_SRC_NAMES := \
	mpstate.c nlr.c nlrx86.c nlrx64.c nlrthumb.c nlraarch64.c nlrmips.c \
	nlrpowerpc.c nlrxtensa.c nlrrv32.c nlrrv64.c nlrsetjmp.c malloc.c gc.c \
	pystack.c qstr.c vstr.c mpprint.c unicode.c mpz.c \
	formatfloat.c parsenumbase.c parsenum.c emitglue.c persistentcode.c \
	runtime.c runtime_utils.c scheduler.c nativeglue.c pairheap.c ringbuf.c \
	cstack.c stackctrl.c argcheck.c warning.c profile.c map.c obj.c \
	objarray.c objattrtuple.c objbool.c objboundmeth.c objcell.c \
	objclosure.c objcode.c objcomplex.c objdeque.c objdict.c objenumerate.c \
	objexcept.c objfilter.c objfloat.c objfun.c objgenerator.c \
	objgetitemiter.c objint.c objint_longlong.c objint_mpz.c objlist.c \
	objmap.c objmodule.c objobject.c objpolyiter.c objproperty.c objnone.c \
	objnamedtuple.c objrange.c objreversed.c objringio.c objset.c \
	objsingleton.c objslice.c objstr.c objstrunicode.c objstringio.c \
	objtemplate.c objtuple.c objtype.c objzip.c opmethods.c sequence.c \
	stream.c binary.c builtinimport.c builtinevex.c builtinhelp.c \
	modarray.c modbuiltins.c modcollections.c modgc.c modio.c modmath.c \
	modcmath.c modmicropython.c modstring.c modstruct.c modsys.c \
	moderrno.c modthread.c modweakref.c vm.c bc.c showbc.c repl.c \
	smallint.c frozenmod.c

PY_OBJS := $(addprefix $(VBUILD)/py/,$(PY_SRC_NAMES:.c=.o))
# vbcc_setjmp.o provides a far-model-correct setjmp/longjmp; it must precede
# -lvc in the link so libvc's broken stock setjmp.o is never pulled.
EXTRA_OBJS := $(VBUILD)/main.o $(VBUILD)/mailbox.o $(VBUILD)/frozen_content.o $(VBUILD)/vbcc_setjmp.o
ALL_OBJS := $(PY_OBJS) $(EXTRA_OBJS)

.PHONY: mpy-vbcc clean-vbcc gen patch-toolchain
mpy-vbcc: patch-toolchain gen $(VBUILD)/mpy.sfc

# Fix vbcc r2's SNES headers (16-bit intptr_t, empty NDEBUG assert) in place;
# idempotent, and needed after any fresh toolchain fetch.
patch-toolchain:
	VBCC=$(VBCC) tools/vbcc_patch_toolchain.sh

# Produce the compiler-agnostic generated sources (genhdr/*, frozen_content.c)
# via the main Makefile. Serialized before the parallel compile to avoid races.
gen:
	$(MAKE) $(MPBUILD)/frozen_content.c

$(VBUILD)/py:
	mkdir -p $(VBUILD)/py

# The bytecode interpreter must be built at -O2: at -O1 vbcc miscompiles the
# huge re-entrant mp_execute_bytecode in a layout-sensitive way (wrong opcodes,
# garbage object pointers — the same class of bug Calypsi hits, but for Calypsi
# -O1 was the correct level and -O2 broke it; for vbcc it is the reverse).
$(VBUILD)/py/vm.o: private VCFLAGS := $(subst -O1,-O2,$(VCFLAGS))

$(VBUILD)/py/%.o: $(MPTOP)/py/%.c | $(VBUILD)/py
	$(VC) $(VCFLAGS) -c $< -o $@

$(VBUILD)/main.o: $(PORT)/main.c | $(VBUILD)/py
	$(VC) $(VCFLAGS) -c $< -o $@

$(VBUILD)/mailbox.o: snes/mailbox.c | $(VBUILD)/py
	$(VC) $(VCFLAGS) -c $< -o $@

$(VBUILD)/vbcc_setjmp.o: snes/vbcc_setjmp.s | $(VBUILD)/py
	$(AS) $(ASFLAGS) $< -o $@

# The vbcc build freezes its OWN program (port/test_vbcc.py, the decisive
# recursion/iteration/methods test) rather than the Calypsi M3 main.py, but
# reuses the firmware qstr pool generated by the main Makefile. The frozen
# module name stays "main.py" so port/main.c finds it.
MPY_CROSS := $(MPTOP)/mpy-cross/build/mpy-cross
$(MPY_CROSS):
	$(MAKE) -C $(MPTOP)/mpy-cross

$(VBUILD)/main.mpy: $(PORT)/test_vbcc.py $(MPY_CROSS) | $(VBUILD)/py
	$(MPY_CROSS) -o $@ -s main.py $<

$(VBUILD)/frozen_content.c: $(VBUILD)/main.mpy $(GENHDR)/qstrdefs.preprocessed.h
	$(PYTHON) $(MPTOP)/tools/mpy-tool.py -f -q $(GENHDR)/qstrdefs.preprocessed.h \
	  -mlongint-impl=none $< > $@

$(VBUILD)/frozen_content.o: $(VBUILD)/frozen_content.c | $(VBUILD)/py
	$(VC) $(VCFLAGS) -c $< -o $@

# Link: startup + our objects + libvc, our custom HiROM layout. rawbin1 output
# is directly a loadable .sfc (header/vectors come from libvc via the cmd file).
$(VBUILD)/mpy.sfc: $(ALL_OBJS) snes/vbcc-snes.cmd
	$(VLINK) -b rawbin1 -nowarn=22 -Cvbcc -T snes/vbcc-snes.cmd \
	  -L $(TGT)/lib -M$(VBUILD)/mpy.map \
	  $(TGT)/lib/startup.o $(ALL_OBJS) -o $@ -lvc

clean-vbcc:
	rm -rf $(VBUILD)
